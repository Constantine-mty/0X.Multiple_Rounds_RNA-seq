category_index_table <- read_csv("~/Project/0X.Multiple_Rounds_RNA-seq/data/GOBP_all_BP_classification_refined.csv")
head(category_index_table)
library(dplyr)
category_relation <- category_index_table %>%
filter(
!is.na(Category),
!is.na(Category_Merged)
) %>%
dplyr::count(Category, Category_Merged, name = "n_GO") %>%
arrange(Category_Merged, desc(n_GO))
category_relation
library(dplyr)
library(tidyr)
library(ggplot2)
# 1. 统计实际存在的映射
category_relation_raw <- category_index_table %>%
filter(
!is.na(Category),
!is.na(Category_Merged)
) %>%
dplyr::count(Category, Category_Merged, name = "n_GO")
# 2. 确定 Category 排序
#    让属于同一个 Category_Merged 的 Category 尽量聚在一起
category_order <- category_relation_raw %>%
group_by(Category) %>%
slice_max(n_GO, n = 1, with_ties = FALSE) %>%
ungroup() %>%
arrange(Category_Merged, desc(n_GO)) %>%
pull(Category)
# 3. 补全所有 Category × Category_Merged 组合
category_relation <- category_relation_raw %>%
complete(
Category,
Category_Merged,
fill = list(n_GO = 0)
) %>%
mutate(
Category = factor(
Category,
levels = rev(category_order)
)
)
# 不着色0的格子
category_relation <- category_relation %>%
mutate(
n_GO_fill = ifelse(n_GO == 0, NA, n_GO)
)
# 4. 绘图
p1 <- ggplot(
category_relation,
aes(
x = Category_Merged,
y = Category
)
) +
geom_tile(
aes(fill = n_GO_fill),
color = "grey70",
linewidth = 0.4
) +
geom_text(
aes(
label = ifelse(n_GO == 0, "", n_GO)
),
size = 3
) +
scale_fill_viridis_c(
option = "C",
trans = "sqrt",
na.value = "white"
) +
labs(
x = "Merged category",
y = "Original category",
fill = "GO terms"
) +
theme_minimal(base_size = 11) +
theme(
panel.grid = element_blank(),
axis.text.x = element_text(
angle = 45,
hjust = 1
),
axis.text.y = element_text(size = 8)
)
p1
