plot_gene_bar <- function(gene,
data = plot.df,
deseq_res = deseq.sig,
ylab = "Expression") {
df <- data %>%
filter(Gene == gene)
if (nrow(df) == 0) {
warning(paste("Gene not found:", gene))
return(NULL)
}
## 获取 DESeq2 显著性
sig.label <- deseq_res %>%
filter(Gene == gene) %>%
pull(sig)
if (length(sig.label) == 0) {
sig.label <- "NA"
}
group_cols <- c(
"WT" = "#3C5488",
"KO" = "#E64B35"
)
## 用于放置显著性括号
ymax <- max(df$Expression, na.rm = TRUE)
## 如果表达量全是0，避免 y.position = 0
if (ymax == 0) ymax <- 1
p <- ggplot(
df,
aes(x = Group, y = Expression, fill = Group)
) +
## mean
stat_summary(
fun = mean,
geom = "col",
width = 0.62,
color = "black",
linewidth = 0.5
) +
## mean ± SEM
stat_summary(
fun.data = mean_se,
geom = "errorbar",
width = 0.16,
linewidth = 0.55,
color = "black"
) +
## biological replicates
geom_point(
position = position_jitter(
width = 0.07,
height = 0,
seed = 123
),
shape = 21,
size = 3.2,
stroke = 0.6,
color = "black"
) +
## DESeq2 significance
# ggpubr::stat_pvalue_manual(
#   data.frame(
#     group1 = "WT",
#     group2 = "KO",
#     y.position = ymax * 1.10,
#     label = sig.label
#   ),
#   label = "label",
#   xmin = "group1",
#   xmax = "group2",
#   y.position = "y.position",
#   tip.length = 0.02,
#   bracket.size = 0.5,
#   size = 5
# ) +
ggpubr::stat_pvalue_manual(
data.frame(
group1 = "WT",
group2 = "KO",
y.position = ymax * 1.10,
label = sig.label
),
label = "label",
xmin = "group1",
xmax = "group2",
y.position = "y.position",
tip.length = 0.02,
bracket.size = 0.5,
size = 5,
inherit.aes = FALSE
) +
scale_fill_manual(
values = group_cols
) +
scale_y_continuous(
expand = expansion(mult = c(0, 0.20))
) +
labs(
title = gene,
x = NULL,
y = ylab
) +
theme_classic(base_size = 12) +
theme(
legend.position = "none",
plot.title = element_text(
size = 14,
face = "italic",
hjust = 0.5,
margin = margin(b = 8)
),
axis.title.y = element_text(
size = 12,
color = "black"
),
axis.text.x = element_text(
size = 11,
color = "black"
),
axis.text.y = element_text(
size = 10,
color = "black"
),
axis.line = element_line(
color = "black",
linewidth = 0.6
),
axis.ticks = element_line(
color = "black",
linewidth = 0.5
),
plot.margin = margin(8, 8, 8, 8)
)
return(p)
}
